# Copy to .env and fill in the three secrets. Never commit .env.

# --- Required -------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Groq API key from https://console.groq.com/keys (free tier is enough)
GROQ_API_KEY=
# Google Cloud API key with the Google Drive API enabled (see README.md, «Google Drive (ключ API)»;
# English: README.en.md, "Google Drive (API key)").
# Without it the bot still starts, but the «Лісовий архів» is not synchronised.
GOOGLE_DRIVE_API_KEY=

# --- Google Drive -----------------------------------------------------------
# Folder «Лісовий архів» (must be shared as "Anyone with the link can view")
GOOGLE_DRIVE_FOLDER_ID=1b_hEjnkQfP8ZVP-OEbnYWqoGSFwXMAP3
DRIVE_SYNC_INTERVAL_SECONDS=600
DRIVE_SYNC_ENABLED=true
# On an empty database, import the bundled «Лісовий архів» snapshot (only for the original folder).
SNAPSHOT_BOOTSTRAP=true
# If more than this fraction of known files is missing from a listing, the removal is confirmed with a
# second complete listing first. Confirmed removals are applied regardless of their number; a failed
# listing never removes anything.
DRIVE_MAX_DELETE_FRACTION=0.5
# Pause between file downloads, and the retry delay after Google's "automated queries" block.
DRIVE_DOWNLOAD_DELAY_SECONDS=2
DRIVE_THROTTLE_RETRY_SECONDS=300
# After repeated blocks the retry delay doubles (300, 600, 1200, …) up to this cap; it resets after a clean sync.
DRIVE_THROTTLE_MAX_RETRY_SECONDS=3600

# --- LLM (Groq) -------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# Used when a model hits a long rate limit (e.g. the free-tier daily quota of ~200K tokens per model).
# Each model has its own quota. Comma-separated; "none" disables fallback.
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# low | medium | high | none (gpt-oss models only). Router/classification vs. answer writing.
GROQ_REASONING_EFFORT=low
GROQ_ANSWER_REASONING_EFFORT=medium
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
# Longer Groq rate-limit waits are not waited out; the user gets a "try again in a minute" message.
GROQ_MAX_RETRY_WAIT_SECONDS=30
# While another model is available, wait at most this long on a rate-limited model before switching.
GROQ_FALLBACK_WAIT_SECONDS=2
# Total time budget for one question (routing + answer + correction, including rate-limit waits).
REQUEST_BUDGET_SECONDS=45
GROQ_ANSWER_MAX_TOKENS=3000

# --- Behaviour --------------------------------------------------------------
TIMEZONE=Europe/Kyiv
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=30
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=55
EMBEDDINGS_ENABLED=true
RETRIEVAL_EVIDENCE_CHARS=7000
LOG_LEVEL=INFO
